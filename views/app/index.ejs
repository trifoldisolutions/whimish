<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <script src="/submit-guard.js" defer></script>
</head>
<body class="min-h-screen bg-white text-slate-900 p-6">
  <h1 class="text-2xl font-bold">App</h1>
  <p class="text-slate-500">App facade index. Placeholder.</p>

  <% if (loggedIn) { %>
    <form method="POST" action="/app/logout" class="mt-4">
      <button class="text-sm text-slate-500 hover:underline disabled:opacity-50" type="submit" disabled>Log out</button>
    </form>
  <% } else { %>
    <p class="mt-4"><a class="text-sm text-blue-600 hover:underline" href="/app/login">Log in / Sign up</a></p>
  <% } %>
</body>
</html>
