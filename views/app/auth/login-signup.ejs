<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
  <script src="/js/password-toggle.js" defer></script>
  <script src="/js/submit-guard.js" defer></script>
</head>
<body class="min-h-screen bg-white text-slate-900 p-6">
  <div class="max-w-md mx-auto space-y-8">
    <h1 class="text-2xl font-bold">Whimish</h1>

    <% if (error) { %>
      <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded px-3 py-2"><%= error %></p>
    <% } %>

    <section class="border border-slate-200 rounded-md p-4">
      <h2 class="font-semibold mb-3">Log in</h2>
      <form method="POST" action="/app/login" class="space-y-3">
        <input class="w-full border border-slate-300 rounded px-3 py-2" type="email" name="email" placeholder="Email" required>
        <div class="relative">
          <input id="login-password" class="w-full border border-slate-300 rounded px-3 pr-10 py-2" type="password" name="password" placeholder="Password" required>
          <button type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center size-8 rounded text-slate-400 hover:text-slate-600">
            <iconify-icon icon="tabler:eye" width="18" height="18"></iconify-icon>
          </button>
        </div>
        <div class="flex justify-end -mt-1.5">
          <a href="/app/forgot-password" class="text-xs text-slate-500 hover:underline">Forgot password?</a>
        </div>
        <button class="w-full bg-slate-900 text-white px-4 py-2 rounded hover:bg-slate-950 disabled:opacity-50" type="submit" disabled>Log in</button>
      </form>
    </section>

    <section class="border border-slate-200 rounded-md p-4">
      <h2 class="font-semibold mb-3">Sign up</h2>
      <form method="POST" action="/app/signup" class="space-y-3">
        <input class="w-full border border-slate-300 rounded px-3 py-2" type="text" name="displayName" placeholder="Display name">
        <input class="w-full border border-slate-300 rounded px-3 py-2" type="email" name="email" placeholder="Email" required>
        <div class="relative">
          <input id="signup-password" class="w-full border border-slate-300 rounded px-3 pr-10 py-2" type="password" name="password" placeholder="Password" required>
          <button type="button" data-password-toggle="signup-password" aria-label="Show password" aria-pressed="false" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center size-8 rounded text-slate-400 hover:text-slate-600">
            <iconify-icon icon="tabler:eye" width="18" height="18"></iconify-icon>
          </button>
        </div>
        <button class="w-full bg-slate-900 text-white px-4 py-2 rounded hover:bg-slate-950 disabled:opacity-50" type="submit" disabled>Sign up</button>
      </form>
    </section>
  </div>
</body>
</html>
