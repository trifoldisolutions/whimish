<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
  <script src="/password-toggle.js" defer></script>
  <script src="/submit-guard.js" defer></script>
  <script src="/custom-select.js" defer></script>
</head>
<body class="min-h-screen bg-slate-900 text-white flex">
  <%- include('../partials/admin-sidebar', { role, roleLabel, displayName, email, basePath, activeNav }) %>

  <main class="flex-1 px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-6 items-start">
    <div class="bg-woodsmoke-900/60 border border-woodsmoke-800 rounded-md p-6">
      <div class="flex items-center gap-2 mb-1">
        <iconify-icon icon="tabler:user-plus" width="18" height="18" class="text-marigold-400"></iconify-icon>
        <h2 class="font-semibold text-sm">Create dev user</h2>
      </div>
      <p class="text-xs text-woodsmoke-400 mb-4">Grants access to Dev Resources only.</p>

      <% if (devUserError) { %>
        <p class="flex items-center gap-2 text-sm text-red-300 bg-red-950/40 border border-red-800/60 rounded-md px-3 py-2.5 mb-4">
          <iconify-icon icon="tabler:alert-circle" width="18" height="18" class="shrink-0"></iconify-icon>
          <%= devUserError %>
        </p>
      <% } %>

      <form method="POST" action="<%= basePath %>/dev-users" class="space-y-4">
        <div>
          <label for="dev-user-name" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Display name</label>
          <input id="dev-user-name" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 py-2.5 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="text" name="displayName" placeholder="Optional">
        </div>
        <div>
          <label for="dev-user-email" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Email</label>
          <input id="dev-user-email" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 py-2.5 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="email" name="email" placeholder="dev@whimish.com" required>
        </div>
        <div>
          <label for="dev-user-role" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Role</label>
          <div class="relative" data-custom-select>
            <input type="hidden" data-custom-select-input name="role" value="<%= creatableDevRoles[0] %>" required>
            <button id="dev-user-role" type="button" class="w-full flex items-center justify-between gap-2 border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 text-sm text-left focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" data-custom-select-trigger aria-haspopup="listbox" aria-expanded="false">
              <span data-custom-select-label><%= formatRole(creatableDevRoles[0]) %></span>
              <iconify-icon icon="tabler:chevron-down" width="16" height="16" class="text-woodsmoke-500 shrink-0"></iconify-icon>
            </button>
            <ul class="absolute z-10 mt-1 w-full max-h-56 overflow-auto border border-woodsmoke-700 bg-woodsmoke-950 rounded-md py-1 hidden" data-custom-select-options role="listbox">
              <% creatableDevRoles.forEach((devRole, i) => { %>
                <li role="option" data-value="<%= devRole %>" tabindex="-1" aria-selected="<%= i === 0 %>" class="px-3 py-2 text-sm hover:bg-woodsmoke-900"><%= formatRole(devRole) %></li>
              <% }) %>
            </ul>
          </div>
        </div>
        <div>
          <label for="dev-user-password" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Password</label>
          <div class="relative">
            <input id="dev-user-password" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 pr-10 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="password" name="password" placeholder="••••••••" required>
            <button type="button" data-password-toggle="dev-user-password" aria-label="Show password" aria-pressed="false" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center size-8 rounded-md text-woodsmoke-500 hover:text-woodsmoke-700">
              <iconify-icon icon="tabler:eye" width="18" height="18"></iconify-icon>
            </button>
          </div>
        </div>
        <button class="w-full bg-amethyst-700 hover:bg-amethyst-800 disabled:opacity-50 text-white font-medium rounded-md px-4 py-2.5 text-sm transition-colors" type="submit" disabled>Create dev user</button>
      </form>
    </div>

    <div class="bg-woodsmoke-900/60 border border-woodsmoke-800 rounded-md overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-woodsmoke-800 text-left text-xs text-woodsmoke-500">
            <th class="px-5 py-3 font-medium">Name</th>
            <th class="px-5 py-3 font-medium">Email</th>
            <th class="px-5 py-3 font-medium w-32">Role</th>
            <th class="px-5 py-3 font-medium w-28">Joined</th>
          </tr>
        </thead>
        <tbody>
          <% devs.forEach(dev => { %>
            <tr class="border-b border-woodsmoke-800 last:border-b-0">
              <td class="px-5 py-3"><%= dev.displayName || '—' %></td>
              <td class="px-5 py-3 text-woodsmoke-300"><%= dev.email %></td>
              <td class="px-5 py-3">
                <span class="text-xs font-medium px-2 py-1 rounded-full bg-amethyst-700/20 text-amethyst-300"><%= formatRole(dev.role) %></span>
              </td>
              <td class="px-5 py-3 text-woodsmoke-500"><%= dev.createdAt.toLocaleDateString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (devs.length === 0) { %>
        <p class="text-sm text-woodsmoke-400 px-5 py-4">No dev accounts found.</p>
      <% } %>
    </div>
    </div>
  </main>
</body>
</html>
