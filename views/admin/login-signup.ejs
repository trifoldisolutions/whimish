<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/output.css">
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
  <script src="/js/password-toggle.js" defer></script>
  <script src="/js/submit-guard.js" defer></script>
</head>
<body class="min-h-screen bg-slate-900 text-white flex items-center justify-center p-6">
  <div class="w-full max-w-md">
    <div class="flex flex-col items-center text-center mb-8">
      <div class="flex items-center justify-center size-12 rounded-full bg-amethyst-700/20 text-amethyst-400 mb-4">
        <iconify-icon icon="tabler:shield-lock" width="26" height="26"></iconify-icon>
      </div>
      <h1 class="text-xl font-semibold">Whimish Admin</h1>
      <p class="text-sm text-woodsmoke-400 mt-1">Sign in to manage the platform</p>
    </div>

    <% if (error) { %>
      <p class="flex items-center gap-2 text-sm text-red-300 bg-red-950/40 border border-red-800/60 rounded-md px-3 py-2.5 mb-6">
        <iconify-icon icon="tabler:alert-circle" width="18" height="18" class="shrink-0"></iconify-icon>
        <%= error %>
      </p>
    <% } %>

    <div class="bg-woodsmoke-900/60 border border-woodsmoke-800 rounded-md p-6">
      <form method="POST" action="<%= basePath %>/login" class="space-y-4" autocomplete="off">
        <div>
          <label for="login-email" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Email</label>
          <div class="relative">
            <iconify-icon icon="tabler:mail" width="18" height="18" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-woodsmoke-500"></iconify-icon>
            <input id="login-email" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md pl-10 pr-3 py-2.5 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="email" name="email" placeholder="you@whimish.com" autocomplete="off" required>
          </div>
        </div>
        <div>
          <label for="login-password" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Password</label>
          <div class="relative">
            <iconify-icon icon="tabler:lock" width="18" height="18" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-woodsmoke-500"></iconify-icon>
            <input id="login-password" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md pl-10 pr-10 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="password" name="password" placeholder="••••••••" autocomplete="off" required>
            <button type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center size-8 rounded-md text-woodsmoke-500 hover:text-woodsmoke-700">
              <iconify-icon icon="tabler:eye" width="18" height="18"></iconify-icon>
            </button>
          </div>
          <div class="flex justify-end mt-1.5">
            <a href="<%= basePath %>/forgot-password" class="text-xs text-woodsmoke-400 hover:underline">Forgot password?</a>
          </div>
        </div>
        <button class="w-full bg-amethyst-700 hover:bg-amethyst-800 disabled:opacity-50 text-white font-medium rounded-md px-4 py-2.5 text-sm transition-colors" type="submit" disabled>
          Log in
        </button>
      </form>
    </div>

    <% if (bootstrapAvailable) { %>
      <div class="mt-6 bg-woodsmoke-900/60 border border-woodsmoke-800 rounded-md p-6">
        <div class="flex items-center gap-2 mb-1">
          <iconify-icon icon="tabler:sparkles" width="18" height="18" class="text-marigold-400"></iconify-icon>
          <h2 class="font-semibold text-sm">First-time setup</h2>
        </div>
        <p class="text-xs text-woodsmoke-400 mb-4">No admin account exists yet — this creates the first one, as founder.</p>
        <form method="POST" action="<%= basePath %>/signup" class="space-y-4" autocomplete="off">
          <div>
            <label for="signup-name" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Display name</label>
            <input id="signup-name" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 py-2.5 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="text" name="displayName" placeholder="Optional" autocomplete="off">
          </div>
          <div>
            <label for="signup-email" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Email</label>
            <input id="signup-email" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 py-2.5 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="email" name="email" placeholder="you@whimish.com" autocomplete="off" required>
          </div>
          <div>
            <label for="signup-password" class="block text-xs font-medium text-woodsmoke-400 mb-1.5">Password</label>
            <div class="relative">
              <input id="signup-password" class="w-full border border-woodsmoke-700 bg-woodsmoke-950 rounded-md px-3 pr-10 text-sm placeholder:text-woodsmoke-600 focus:outline-none focus:border-amethyst-500 focus:ring-2 focus:ring-amethyst-500/30 transition" type="password" name="password" placeholder="••••••••" autocomplete="off" required>
              <button type="button" data-password-toggle="signup-password" aria-label="Show password" aria-pressed="false" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center size-8 rounded-md text-woodsmoke-500 hover:text-woodsmoke-700">
                <iconify-icon icon="tabler:eye" width="18" height="18"></iconify-icon>
              </button>
            </div>
          </div>
          <button class="w-full bg-woodsmoke-800 hover:bg-woodsmoke-900 disabled:opacity-50 text-white font-medium rounded-md px-4 py-2.5 text-sm transition-colors" type="submit" disabled>Create founder account</button>
        </form>
      </div>
    <% } else { %>
      <p class="flex items-center justify-center gap-1.5 text-xs text-woodsmoke-500 mt-6">
        <iconify-icon icon="tabler:lock-square-rounded" width="14" height="14"></iconify-icon>
        Self-service sign-up is disabled — ask an administrator for access.
      </p>
    <% } %>
  </div>
</body>
</html>
