<aside class="w-64 shrink-0 border-r border-woodsmoke-800 bg-woodsmoke-900/60 flex flex-col">
  <div class="px-5 py-4 border-b border-woodsmoke-800 flex items-center gap-3">
    <div class="flex items-center justify-center size-9 rounded-full bg-amethyst-700/20 text-amethyst-400 shrink-0">
      <iconify-icon icon="tabler:shield-lock" width="20" height="20"></iconify-icon>
    </div>
    <span class="font-semibold truncate">Whimish Admin</span>
  </div>

  <nav class="flex-1 px-3 py-4 space-y-1">
    <a href="<%= basePath %>" class="flex items-center gap-2.5 px-3 h-10 rounded-md text-sm transition-colors <%= activeNav === 'overview' ? 'bg-amethyst-700/20 text-amethyst-300' : 'text-woodsmoke-300 hover:bg-woodsmoke-950 hover:text-woodsmoke-500' %>">
      <iconify-icon icon="tabler:layout-dashboard" width="18" height="18"></iconify-icon>
      Overview
    </a>

    <% if (['founder', 'superadmin'].includes(role)) { %>
      <a href="<%= basePath %>/admins" class="flex items-center gap-2.5 px-3 h-10 rounded-md text-sm transition-colors <%= activeNav === 'admin' ? 'bg-amethyst-700/20 text-amethyst-300' : 'text-woodsmoke-300 hover:bg-woodsmoke-950 hover:text-woodsmoke-500' %>">
        <iconify-icon icon="tabler:shield-cog" width="18" height="18"></iconify-icon>
        Admin
      </a>
    <% } %>

    <% if (['founder', 'superadmin', 'content_moderator', 'support_admin'].includes(role)) { %>
      <a href="<%= basePath %>/users" class="flex items-center gap-2.5 px-3 h-10 rounded-md text-sm transition-colors <%= activeNav === 'user' ? 'bg-amethyst-700/20 text-amethyst-300' : 'text-woodsmoke-300 hover:bg-woodsmoke-950 hover:text-woodsmoke-500' %>">
        <iconify-icon icon="tabler:users" width="18" height="18"></iconify-icon>
        User
      </a>
    <% } %>
  </nav>

  <div class="px-3 py-4 border-t border-woodsmoke-800">
    <div class="flex items-center gap-2.5 px-2 mb-3 min-w-0">
      <div class="flex items-center justify-center size-8 rounded-full bg-woodsmoke-800 text-woodsmoke-300 text-xs font-semibold shrink-0">
        <%= (displayName || email || '?').charAt(0).toUpperCase() %>
      </div>
      <div class="min-w-0">
        <p class="text-sm truncate"><%= displayName || email %></p>
        <p class="text-xs text-woodsmoke-500 truncate"><%= roleLabel %></p>
      </div>
    </div>
    <form method="POST" action="<%= basePath %>/logout">
      <button class="w-full h-9 flex items-center justify-center gap-1.5 rounded-md text-sm text-woodsmoke-300 hover:bg-woodsmoke-950 hover:text-woodsmoke-500 disabled:opacity-50 transition-colors" type="submit" disabled>
        <iconify-icon icon="tabler:logout" width="16" height="16"></iconify-icon>
        Log out
      </button>
    </form>
  </div>
</aside>
